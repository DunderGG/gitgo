@startuml sequence-open-repo
title Opening a Repository

actor User as user 
participant "RepoSelector" as RS
participant "Zustand Store" as ZS
participant "CommitList" as CL
participant "Wails Bridge" as wails
participant "app.App (app/app.go)" as app 
participant "git package (git/*.go)" as git 

legend right
    app.App = Go struct exposed to frontend by Wails
    git package = helper functions in git/*.go
    Go errors are shown in the UI as error state
endlegend

user -> RS : Click "Open Repository"
RS -> wails : SelectDirectory()
wails -> app : SelectDirectory()
app --> wails : path (or "" if cancelled)
wails --> RS : path string

alt user cancelled (empty path)
    RS -> RS : no-op
else path selected
    RS -> wails : OpenRepository(path)
    wails -> app : OpenRepository(path)
    app -> git : Open(path)

    alt path is not a git repository
        git --> app : error
        app --> wails : (zero RepoInfo, error)
        wails --> RS : error returned to UI
        RS -> ZS : setError(message)
    else detached HEAD
        git --> app : ErrDetachedHead
        app --> wails : (zero RepoInfo, error)
        wails --> RS : error returned to UI
        RS -> ZS : setError(message)
    else in-progress git operation detected
        git --> app : ErrOperationInProgress
        app --> wails : (zero RepoInfo, error)
        wails --> RS : error returned to UI
        RS -> ZS : setError(message)
    else success
        git --> app : *RepoState (branch, remote flags, unpushed set)
        app --> wails : RepoInfo
        wails --> RS : RepoInfo

        RS -> wails : GetCommitLog()
        wails -> app : GetCommitLog()
        app -> git : Log(state, 0)
        git --> app : []CommitEntry
        app --> wails : []CommitSummary
        wails --> RS : []CommitSummary

        RS -> ZS : setRepo(RepoInfo, []CommitSummary)
        ZS --> CL : commits (reactive)
        CL -> CL : Render commit list
    end
end

@enduml
