@startuml sequence-open-repo
title Opening a Repository

actor User as U
participant "RepoSelector" as RS
participant "Zustand Store" as ZS
participant "CommitList" as CL
participant "Wails Bridge" as W
participant "App Controller" as AC
participant "git package" as GS

U -> RS : Click "Open Repository"
RS -> W : SelectDirectory()
W -> AC : SelectDirectory()
AC --> W : path (or "" if cancelled)
W --> RS : path string

alt user cancelled (empty path)
    RS -> RS : no-op
else path selected
    RS -> W : OpenRepository(path)
    W -> AC : OpenRepository(path)
    AC -> GS : Open(path)

    alt path is not a git repository
        GS --> AC : error
        AC --> W : ("", error)
        W --> RS : rejected Promise
        RS -> ZS : setError(message)
    else detached HEAD
        GS --> AC : ErrDetachedHead
        AC --> W : ("", error)
        W --> RS : rejected Promise
        RS -> ZS : setError(message)
    else in-progress git operation detected
        GS --> AC : ErrOperationInProgress
        AC --> W : ("", error)
        W --> RS : rejected Promise
        RS -> ZS : setError(message)
    else success
        GS --> AC : *RepoState (branch, remote flags, unpushed set)
        AC --> W : RepoInfo
        W --> RS : RepoInfo

        RS -> W : GetCommitLog()
        W -> AC : GetCommitLog()
        AC -> GS : Log(state, 0)
        GS --> AC : []CommitEntry
        AC --> W : []CommitSummary
        W --> RS : []CommitSummary

        RS -> ZS : setRepo(RepoInfo, []CommitSummary)
        ZS --> CL : commits (reactive)
        CL -> CL : Render commit list
    end
end

@enduml
