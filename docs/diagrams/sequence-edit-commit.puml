@startuml sequence-edit-commit
title Editing a Commit

actor User as U
participant "CommitList" as CL
participant "EditPanel" as EP
participant "ConfirmDialog" as CD
participant "Wails Bridge" as wails
participant "app.App (app/app.go)" as app 
participant "git package (git/*.go)" as git 

legend right
    app.App = Go struct exposed to frontend by Wails
    git package = helper functions in git/*.go
    Go errors are shown in the UI as error state
endlegend

user -> CL : Click unpushed commit
CL -> wails : GetCommitDetail(hash)
wails -> app : GetCommitDetail(hash)
app -> git  : CommitObject(hash)
git  --> app : CommitDetail
app --> wails : CommitDetail
wails --> CL : CommitDetail
CL -> EP : Populate form fields

user -> EP : Edit message / date / author
user -> EP : Click "Apply Changes"
EP -> CD : Show diff preview (old vs new)
user -> CD : Confirm

CD -> wails : UpdateCommit(hash, EditRequest)
wails -> app : UpdateCommit(hash, req)
app -> app : Check state.UnpushedHashes[hash]

alt last commit
    app -> git  : AmendCommit(req)
else older commit
    app -> git  : RebaseRewrite(hash, req)
end

git  --> app : OperationResult
app --> wails : OperationResult
wails --> EP : OperationResult
EP -> CL : Trigger log refresh

@enduml
