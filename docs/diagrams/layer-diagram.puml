@startuml layer-diagram
title GitGo — High-Level Layer Diagram

rectangle "Desktop Shell (Wails v2)" {

    rectangle "Frontend — React / TypeScript" as FE {
        component [RepoSelector] as RS
        component [CommitList] as CL
        component [EditPanel] as EP
        component [ConfirmDialog] as CD
        component [StatusBar] as SB

        RS --> CL
        CL --> EP
        EP --> CD
    }

    rectangle "Wails IPC Bridge" as Bridge {
        component [Go Bindings\n(wails.Bind)] as BND
        component [App Events] as EVT
    }

    rectangle "Backend — Go" as BE {
        component [app.App\n(app/app.go)] as AC
        component [git package\n(git/*.go)] as GS
        component [Domain Models\n(app/models.go)] as MD

        AC --> GS
        AC --> MD
    }

    rectangle "go-git Layer" as GIT {
        component [git.Repository] as RP
        component [git.Worktree] as WK
    }

    FE --> Bridge : calls
    Bridge --> BE : invokes
    BE --> GIT : uses
    Bridge --> FE : events
}

@enduml
